{
  "name": "dsh-in-convo-mode-change",
  "version": "1.3.0",
  "description": "Native DSH mode selector with queued, safe idle-boundary switching during active Turns.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs",
    "src"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-agent-preset",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "agent-preset",
    "conversation-mode"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iBobbyTS/dsh-in-convo-mode-change.git"
  },
  "packageManager": "pnpm@10.28.2",
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.1",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "react": "18.3.1",
    "tsdown": "0.22.14",
    "typescript": "5.9.3"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.host.json && tsc -p tsconfig.client.json",
    "build:runtime": "node scripts/build-runtime.mjs",
    "test": "node scripts/check.mjs test",
    "check:dist": "node scripts/check.mjs dist",
    "check": "node scripts/check.mjs all"
  }
}
